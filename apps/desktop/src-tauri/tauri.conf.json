{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThrottleWatch",
  "version": "0.1.0",
  "identifier": "com.throttlewatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "ThrottleWatch", "width": 960, "height": 720 }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": [
      "resources/pawnio/PawnIO_setup_2.2.0.exe",
      "resources/pawnio-manifest.json"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
