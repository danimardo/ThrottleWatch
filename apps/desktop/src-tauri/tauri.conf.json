{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThrottleWatch",
  "version": "0.1.0",
  "identifier": "com.throttlewatch.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ThrottleWatch",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 600,
        "decorations": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../../sensor-agent/bin/Release/net10.0-windows/win-x64/publish/*": "collector/",
      "resources/pawnio/PawnIO_setup_2.2.0.exe": "resources/pawnio/PawnIO_setup_2.2.0.exe",
      "resources/pawnio-manifest.json": "resources/pawnio-manifest.json",
      "../../../docs/help/es.md": "help/es.md",
      "../../../docs/help/en.md": "help/en.md"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Spanish"],
        "displayLanguageSelector": true,
        "installerHooks": "installer/pawnio-uninstall-notice.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/ThrottleWatch/ThrottleWatch/releases/latest/download/update-manifest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
