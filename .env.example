# Solo para desarrollo y pruebas E2E de CI; nunca se distribuye.
PUBLIC_LOG_LEVEL=info

# Variables TW_DEV_*: solo las lee una compilación de depuración o `e2e`
# (apps/desktop/src-tauri/src/dev_faults.rs). Una compilación release no las lee ni las nombra:
# una prueba lo comprueba sobre el propio código fuente. Son valores de entorno del proceso, no
# de este fichero; están aquí únicamente para que consten (constitución, principio XV).
#
# TW_DEV_STORAGE_FAIL_WRITES=<n>  las n primeras escrituras de sesión fallan (disco lleno). Cada
#                                 reintento fallido cuesta storage.retry_s (60 s): con n=1 el aviso
#                                 aparece y se va en ~1 min; con n=3, en ~3 min.
# TW_DEV_CORRUPT_DB=1             daña la cabecera de la base existente antes de abrirla.
# TW_DEV_DATA_DIR=<ruta>          usa esa carpeta como directorio de datos en lugar de
#                                 %APPDATA%\com.throttlewatch.desktop (redirigir APPDATA no sirve:
#                                 Tauri lo resuelve sin mirar esa variable).
# TW_DEV_COLLECTOR_CMD=<json>     array JSON ["programa","arg",...] que se arranca en lugar del
#                                 colector real; ver apps/desktop/e2e-native/fake-collector.mjs.
