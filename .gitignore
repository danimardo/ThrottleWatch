# Node / pnpm / npm
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# Rust (apps/desktop/src-tauri, once the app exists)
# Cargo.lock is intentionally tracked for a binary crate (reproducible builds).
target/
mutants.out/
.tools/

# .NET (apps/sensor-agent, once the app exists)
bin/
!apps/desktop/src-tauri/src/bin/
!apps/desktop/src-tauri/src/bin/*.rs
obj/
*.user

# PawnIO installer: fetched at build time by scripts/fetch-pawnio.mjs (hash and Authenticode
# verified against resources/pawnio-manifest.json); the repository does not host the binary.
apps/desktop/src-tauri/resources/pawnio/*.exe

# Local logs and runtime artifacts
.logs/
logs/
*.log

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Test reports and tool caches
test-results/
playwright-report/
TestResults/
.specify/integrations/.cache/

# Browser automation screenshots taken during verification
.playwright-mcp/

# Secrets — never commit
.env
.env.*
!.env.example
*.pfx
*.pem
*.key
